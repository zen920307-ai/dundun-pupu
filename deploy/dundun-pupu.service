[Unit]
Description=Dundun and Pupu website
After=network.target

[Service]
Type=simple
User=dundun-pupu
Group=dundun-pupu
WorkingDirectory=/srv/dundun-pupu/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8092
ExecStart=/opt/dundun-pupu/node/bin/node /srv/dundun-pupu/current/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=384M

[Install]
WantedBy=multi-user.target
